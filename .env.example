# A2A agent endpoints (local POC)
SETUP_AGENT_URL=http://127.0.0.1:9101
BUILDER_AGENT_URL=http://127.0.0.1:9102
SETUP_AGENT_HOST=127.0.0.1
SETUP_AGENT_PORT=9101
BUILDER_AGENT_HOST=127.0.0.1
BUILDER_AGENT_PORT=9102

# Shared POC workspace. Both local agents must see this same path.
WORKSPACE_ROOT=./workspaces
CONTROL_PLANE_DB=./state/control_plane.sqlite3

# gemini = live Gemini code generation; openai_compatible = OpenAI-compatible API; demo = offline starter.
LLM_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=90

# Dependency installation / execution safeguards
PACKAGE_INSTALL_TIMEOUT_SECONDS=300
CODE_EXECUTION_TIMEOUT_SECONDS=30
MAX_GENERATED_FILES=35
MAX_GENERATED_BYTES=500000
